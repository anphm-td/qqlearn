<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: nền splash màu kem của app, icon không cần hộp trắng -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowSplashScreenBackground">#FBF6EE</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#FBF6EE</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
